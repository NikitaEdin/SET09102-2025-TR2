<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:REA.ViewModels"
             x:Class="REA.Views.DataInfoPage"
             Title="Security &amp; Data Information">
    <ContentPage.BindingContext>
        <viewModels:DataInfoViewModel x:Name="ViewModel" />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="30" >
                <Label Text="System Role Counts"/>

                <ListView x:Name="RolesCountListView" SelectionMode="Single"
                          ItemsSource="{Binding RoleCounts}"
                          ItemSelected="OnUserRoleSelected"
                          MinimumHeightRequest="200">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextCell Text="{Binding Item1.Title}" Detail="{Binding Item2}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Label Text="Make sure only the correct users have access to administrate the system"/>

                <Button Text="Edit Users" Command="{Binding NavigateToUserManagementCommand}"/>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>